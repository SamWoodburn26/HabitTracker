# Server (never expose these to the browser)
MONGODB_URI=mongodb://127.0.0.1:27017/habitsApp
JWT_SECRET=replace-with-a-long-random-string
PORT=3001

# Client — leave empty for local Vite proxy to the API
# VITE_API_URL=https://your-api.example.com

# Optional local Ollama prompts
# VITE_OLLAMA_URL=http://127.0.0.1:11434
# VITE_OLLAMA_MODEL=llama3.2
